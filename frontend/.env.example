# Copia como .env.local (nunca subas .env.local al repositorio)

# URL del backend SIN "/api" al final (el cliente lo agrega)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase (clave pública "anon"; solo se usa para notificaciones en tiempo real)
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto JWT de Supabase (Settings → API). Lo usa el middleware (src/proxy.ts)
# para proteger las rutas. NO lleva prefijo NEXT_PUBLIC_: nunca llega al navegador.
SUPABASE_JWT_SECRET=
