# Copia este archivo como .env y llena los valores reales (nunca subas .env al repositorio)
PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (endpoints /api/ia y predicción del dashboard)
GEMINI_API_KEY=

# PDF Food Safety Audit
# Ruta de Chrome solo para desarrollo local en Windows
CHROME_EXECUTABLE_PATH=
# Hosts extra (separados por coma) desde los que el PDF puede cargar imágenes.
# El host de SUPABASE_URL ya está permitido por defecto.
PDF_ALLOWED_HOSTS=

# Número de proxies delante del backend (Render = 1). Usa 0 si no hay proxy.
TRUST_PROXY=1

# Precios: con "true" el servidor guarda los totales que él calcula (ignora los del navegador).
# Déjalo vacío al principio: solo se registran diferencias en el log con el prefijo [precios].
PRICING_ENFORCE=

# Orígenes permitidos por CORS (separados por coma). Vacío = lista por defecto del código.
CORS_ORIGINS=

# Permisos por rol (columna usuarios.rol, separados por coma). Vacío = cualquier usuario autenticado.
# Crear/editar/desactivar servicios y tarifas especiales de clientes:
ROLES_GESTION_CATALOGO=
# Eliminar clientes:
ROLES_ELIMINAR_CLIENTES=

# production oculta los mensajes internos de la base de datos en las respuestas de error
NODE_ENV=production

# Roles (columna usuarios.rol, separados por coma) que pueden crear usuarios y
# restablecer contraseñas desde el panel "Usuarios". Si queda vacío, NADIE puede.
# Ej.: ROLES_ADMIN_USUARIOS=Coordinador de Servicio Técnico,Service Sales Manager
ROLES_ADMIN_USUARIOS=
